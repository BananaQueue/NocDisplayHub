<Window x:Class="NocDisplayHub.Compositor.TerminateOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        Width="118" Height="34">
    <Border x:Name="RootBorder"
            Background="#14181D"
            BorderBrush="#FF4D4F"
            BorderThickness="1"
            CornerRadius="3"
            Opacity="0.45"
            Cursor="Hand"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <TextBlock Text="■ STOP WALL"
                   Foreground="#FF4D4F"
                   FontFamily="Cascadia Mono, Consolas, Courier New"
                   FontSize="11"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</Window>
