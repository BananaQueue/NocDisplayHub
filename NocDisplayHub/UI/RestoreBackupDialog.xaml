<Window x:Class="NocDisplayHub.UI.RestoreBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Previous Version"
        Width="480"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0E11"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                Grid.Row="0"
                Foreground="#E8ECEF"
                FontSize="13"
                Margin="0,0,0,10"
                TextWrapping="Wrap"/>

        <ListBox x:Name="BackupList"
                Grid.Row="1"
                Background="#1C2126"
                Foreground="#E8ECEF"
                BorderBrush="#262D33"
                FontSize="13"
                MouseDoubleClick="BackupList_MouseDoubleClick"/>

        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
            <Button x:Name="RestoreButton"
                    Content="RESTORE"
                    Click="RestoreButton_Click"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Background="#4FC3F7"
                    Foreground="#0B0E11"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
            <Button Content="CANCEL"
                    Width="90"
                    Height="32"
                    IsCancel="True"
                    Background="#1C2126"
                    Foreground="#E8ECEF"
                    BorderBrush="#262D33"/>
        </StackPanel>
    </Grid>
</Window>
