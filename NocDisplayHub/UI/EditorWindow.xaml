<Window x:Class="NocDisplayHub.UI.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NOC Display Hub — Editor"
        Height="820" Width="900"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- Split picker -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Split:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
            <Button x:Name="OneByOneButton" Content="1x1" Click="PresetButton_Click" Tag="OneByOne" />
            <Button x:Name="OneByTwoButton" Content="1x2" Click="PresetButton_Click" Tag="OneByTwo" />
            <Button x:Name="TwoByOneButton" Content="2x1" Click="PresetButton_Click" Tag="TwoByOne" />
            <Button x:Name="TwoByTwoButton" Content="2x2" Click="PresetButton_Click" Tag="TwoByTwo" />
            <Button x:Name="TwoByThreeButton" Content="2x3" Click="PresetButton_Click" Tag="TwoByThree" />
            <Button x:Name="BackButton" Content="◀ Back to wall" Click="Back_Click" Margin="24,4,4,4" Visibility="Collapsed" />
            <Button Content="Launch Wall" Click="LaunchWall_Click" Margin="8,4,4,4" Background="#FF0E639C" />
        </StackPanel>

        <CheckBox x:Name="AutoStartCheckBox" DockPanel.Dock="Top" Content="Launch automatically when Windows starts"
                  Foreground="White" Margin="0,8,0,0" Click="AutoStartCheckBox_Click" />

        <!-- Assignment panel -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="SelectedCellLabel" Text="Select a cell above" FontWeight="Bold" Margin="0,0,0,8" />

                <!-- Sub-grid split controls: only meaningful for a top-level cell, not while drilled in -->
                <StackPanel x:Name="SplitPanel" Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="False">
                    <Label Content="Split into widgets:" VerticalAlignment="Center" />
                    <Button Content="None" Click="SubSplitButton_Click" Tag="{x:Null}" />
                    <Button Content="1x2" Click="SubSplitButton_Click" Tag="OneByTwo" />
                    <Button Content="2x1" Click="SubSplitButton_Click" Tag="TwoByOne" />
                    <Button Content="2x2" Click="SubSplitButton_Click" Tag="TwoByTwo" />
                </StackPanel>

                <StackPanel x:Name="AssignmentPanel" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Source type:" VerticalAlignment="Center" />
                        <ComboBox x:Name="SourceTypeCombo" Width="160" VerticalAlignment="Center">
                            <ComboBoxItem Content="Browser URL" Tag="Browser" IsSelected="True" />
                            <ComboBoxItem Content="Native app" Tag="NativeApp" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Value:" VerticalAlignment="Center" Width="80" />
                        <TextBox x:Name="ValueTextBox" Width="500" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply to cell" Click="ApplyToCell_Click" Background="#FF0E639C" />
                        <Button Content="Unassign" Click="Unassign_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grid preview -->
        <Border BorderBrush="#FF3F3F46" BorderThickness="1" Margin="0,12,0,0">
            <Canvas x:Name="PreviewCanvas" Background="#FF101010" Width="800" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </DockPanel>
</Window>
